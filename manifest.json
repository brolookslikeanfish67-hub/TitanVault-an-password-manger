{
  "manifest_version": 3,
  "name": "TitanVault: Zero-Knowledge PM",
  "version": "1.0",
  "description": "A encrypted password manager.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
